<UserControl
    x:Class="MyToDo.Views.ToDoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    d:Height="450"
    d:Width="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="仿宋"
     TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WhiteBrush" Color="White" />
    </UserControl.Resources>
    <md:DialogHost>
        <md:DrawerHost IsRightDrawerOpen="{Binding IsRightDrawerOpen}">


            <!--  侧边栏  -->


            <md:DrawerHost.RightDrawerContent>
                <DockPanel
                    Width="350"
                    Margin="10"
                    LastChildFill="False">
                    <!--  标题  -->
                    <TextBlock
                        Margin="0,0,0,15"
                        DockPanel.Dock="Top"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource WhiteBrush}"
                        Text="添加待办" />

                    <!--  状态选择  -->
                    <StackPanel
                        Margin="0,0,0,15"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource WhiteBrush}"
                            Text="状态： " />
                        <ComboBox Width="60" Foreground="{StaticResource WhiteBrush}">
                            <ComboBoxItem>待办</ComboBoxItem>
                            <ComboBoxItem>已完成</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>


                    <TextBox
                        Margin="0,0,0,10"
                        Padding="5"
                        md:HintAssist.Hint="请输入待办概要"
                        DockPanel.Dock="Top"
                        FontSize="16"
                        Foreground="{StaticResource WhiteBrush}" />


                    <TextBox
                        MinHeight="100"
                        Margin="0,0,0,15"
                        Padding="5"
                        md:HintAssist.Hint="请输入待办内容"
                        AcceptsReturn="True"
                        DockPanel.Dock="Top"
                        FontSize="16"
                        Foreground="{StaticResource WhiteBrush}"
                        TextWrapping="Wrap" />


                    <Button
                        Width="300"
                        Height="40"
                        Command="{Binding AddCommand}"
                        Content="添加到待办"
                        DockPanel.Dock="Top"
                        FontSize="16"
                        Foreground="White" />
                </DockPanel>
            </md:DrawerHost.RightDrawerContent>

            <!--  上部分  -->


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBox
                        Width="250"
                        Margin="20,20,20,10"
                        VerticalAlignment="Center"
                        md:HintAssist.Hint="查找待办事项......"
                        md:TextFieldAssist.HasClearButton="True"
                        FontSize="18"
                        Foreground="White" />
                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="White"
                        Text="筛选:  " />
                    <ComboBox Foreground="White" SelectedIndex="0">
                        <ComboBoxItem>全部</ComboBoxItem>
                        <ComboBoxItem>待办</ComboBoxItem>
                        <ComboBoxItem>已完成</ComboBoxItem>
                    </ComboBox>

                </StackPanel>

                <Button
                    Width="120"
                    Margin="10,5"
                    HorizontalAlignment="Right"
                    Command="{Binding AddCommand}"
                    Content="+ 添加待办" />





                <!--  各小块  -->
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        ItemsSource="{Binding ToDoDtos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>
                                <md:TransitioningContent OpeningEffect="{md:TransitionEffect Kind=ExpandIn, Duration=0:0:1}">
                                    <Grid
                                        Width="220"
                                        MinHeight="180"
                                        MaxHeight="250"
                                        Margin="10">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Border
                                            Grid.RowSpan="2"
                                            Background="#FF1ECA3A"
                                            CornerRadius="10" />


                                        <md:PopupBox
                                            HorizontalAlignment="Right"
                                            Panel.ZIndex="1"
                                            Foreground="White">
                                            <Button Content="删除" />
                                        </md:PopupBox>

                                        <TextBlock
                                            Padding="10"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource WhiteBrush}"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Padding="10,5"
                                            FontSize="18"
                                            Foreground="{StaticResource WhiteBrush}"
                                            Text="{Binding Content}" />


                                        <Canvas Grid.RowSpan="2" ClipToBounds="True">
                                            <Border
                                                Canvas.Top="10"
                                                Canvas.Right="-30"
                                                Width="120"
                                                Height="120"
                                                Background="#FFFFFF"
                                                CornerRadius="50"
                                                Opacity="0.1" />
                                            <Border
                                                Canvas.Top="60"
                                                Canvas.Right="-0"
                                                Width="120"
                                                Height="120"
                                                Background="#FFFFFF"
                                                CornerRadius="50"
                                                Opacity="0.1" />
                                        </Canvas>



                                    </Grid>
                                </md:TransitioningContent>
                            </DataTemplate>

                        </ItemsControl.ItemTemplate>


                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </md:DrawerHost>





    </md:DialogHost>
</UserControl>
